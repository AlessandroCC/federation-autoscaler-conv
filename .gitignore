# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
certs/
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# Compiled test binaries (go build ./federation-tests/comparative-*)
/comparative-eco
/comparative-latency
federation-tests/comparative-eco/comparative-eco
federation-tests/comparative-latency/comparative-latency
# Test results generated inside test directories
federation-tests/comparative-eco/results/
federation-tests/comparative-latency/results/

# Test results: every run writes in here, so the folder stays ignored and a fresh
# run never shows up in git status. The runs reported by the thesis are the
# exception: they were added once with `git add -f` and, being tracked, this rule
# no longer applies to them. See results/README.md.
results/

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# local thesis drafts (source of truth is the Overleaf project)
/thesis/

# Python bytecode from the federation-tests/scripts analysis tools
__pycache__/
*.pyc

# Per-deployment Ansible inventory (VM addresses, registry, image tag).
# inventory.yaml.example is the committed template.
deploy/ansible/inventory.yaml

# local copy of the Overleaf thesis project
/OVERLEAF/
