# ============================================================
#  Scalability Test Configuration
# ============================================================
#  Edit the values below, then run:
#
#    bash tests/scalability/run-scalability-test.sh
#
#  The script handles everything else: Kind cluster, CRDs,
#  Broker, certificates, test execution, and cleanup.
# ============================================================

# ---- Agents ------------------------------------------------
CONSUMERS=5
PROVIDERS=5

# ---- Test duration -----------------------------------------
# Measurement phase length (after warm-up completes).
DURATION=5m

# ---- Traffic intervals -------------------------------------
# How often each agent sends its periodic request.
ADVERTISEMENT_INTERVAL=30s    # Provider POST /advertisements
HEARTBEAT_INTERVAL=15s        # Consumer POST /heartbeat
EVAL_INTERVAL=5s              # Consumer GET  /nodegroups
INSTRUCTION_POLL_INTERVAL=5s  # Both    GET  /instructions
INSTRUCTION_POLL=true         # Set false to skip instruction polling entirely

# ---- Timeouts & retries ------------------------------------
REQUEST_TIMEOUT=10s           # Per-HTTP-attempt timeout
WARMUP_TIMEOUT=60s            # Max wait for all agents to succeed once
CLIENT_MAX_RETRIES=0          # 0 = single attempt (clean latency); 3 = mirrors production

# ---- Synthetic provider resources --------------------------
PROVIDER_CPU=16               # CPU cores each provider advertises
PROVIDER_MEMORY=32Gi          # Memory each provider advertises

# ---- Broker resource monitoring ----------------------------
#   none    — no sampling (default; works everywhere)
#   k8s     — kubectl top pod (requires metrics-server in Kind)
#   process — ps on the local Broker PID (auto-detected by the script)
MONITOR_MODE=none
MONITOR_INTERVAL=5s

# ---- Infrastructure ----------------------------------------
KIND_CLUSTER_NAME=scaltest            # Name of the Kind cluster to create/reuse
BROKER_NAMESPACE=federation-autoscaler-system
BROKER_PORT=9443                      # Broker mTLS API port
KEEP_CLUSTER=true                     # Keep Kind cluster after test (faster re-runs)

# ---- Output ------------------------------------------------
# Leave empty for auto-generated timestamp-based directory
# under tests/scalability/results/.
OUTPUT_DIR=""
